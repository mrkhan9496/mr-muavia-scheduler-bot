# ============================================
# MR MUAVIA SCHEDULER BOT - Environment Config
# Copy to .env and fill in. NEVER commit .env!
# ============================================

# --- Bot identity ---
BOT_NAME=MUAVIA MINI BOT
OWNER_NUMBER=923200799496

# --- Database (Neon Postgres, free) ---
# If empty, bot uses local data/bot_data.json instead.
DATABASE_URL=

# --- Gemini (Google AI Studio - free key, no card) ---
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Image model (current): gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Chat model for chatbot + prompt generator
GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- AI chatbot fallback (optional) ---
# Used only if Gemini chat fails. Any OpenAI-compatible endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# --- WhatsApp Channel ---
# Your channel JID, e.g. 1203630XXXXXXXX@newsletter
# Find it: open channel info in WhatsApp, or use .channelstatus after first post.
CHANNEL_JID=

# --- Timezone (default Pakistan) ---
TIMEZONE=Asia/Karachi

# --- Server ---
PORT=3000
